{
  "extends": "../../tsconfig.json",
  "include": [
    "src/**/*",
    "config/**/*",
    "types/**/*",
    "*.d.ts"
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "moduleResolution": "bundler",
    "paths": {
      // 路径映射
      "@/*": [
        "./src/*"
      ],
      "#/*": [
        "types/*"
      ],
    },
  },
}