{
  "extends": "../../tsconfig.json",
  "include": [
    "src/**/*",
    "types/**/*",
    "*.d.ts",
  ],
  "exclude": [
    "node_modules",
    ".git",
    "dist",
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      // 路径映射
      "@/*": [
        "./src/*"
      ],
      "#/*": [
        "types/*"
      ],
    },
  },
}