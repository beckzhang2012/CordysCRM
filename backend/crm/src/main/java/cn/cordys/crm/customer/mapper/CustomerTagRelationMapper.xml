<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cordys.crm.customer.mapper.CustomerTagRelationMapper">

    <select id="selectTagIdsByCustomerId" resultType="java.lang.String">
        SELECT tag_id
        FROM customer_tag_relation
        WHERE customer_id = #{customerId}
        ORDER BY create_time DESC
    </select>

    <select id="selectCustomerIdsByTagId" resultType="java.lang.String">
        SELECT customer_id
        FROM customer_tag_relation
        WHERE tag_id = #{tagId}
        ORDER BY create_time DESC
    </select>

    <delete id="deleteByCustomerId">
        DELETE FROM customer_tag_relation
        WHERE customer_id = #{customerId}
    </delete>

    <delete id="deleteByTagId">
        DELETE FROM customer_tag_relation
        WHERE tag_id = #{tagId}
    </delete>

    <delete id="deleteByCustomerIdAndTagId">
        DELETE FROM customer_tag_relation
        WHERE customer_id = #{customerId}
          AND tag_id = #{tagId}
    </delete>

</mapper>
